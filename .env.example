# Read-only data
LEVPLAY_SVM_READ_RPC=
LEVPLAY_SVM_RPC_URLS_JSON=["https://provider-a.example","https://provider-b.example"]

# One exact schema-v2 manifest binds program, state, vaults, authorities,
# release artifacts and the hashes of the venue/product admission manifests.
LEVPLAY_SVM_DEPLOYMENT_MANIFEST_JSON=
LEVPLAY_SVM_DEPLOYMENT_MANIFEST_HASH=

# Last gate; never enable before every other check passes
LEVPLAY_SVM_EXECUTION_ENABLED=false
LEVPLAY_SVM_VENUE_MANIFEST_JSON=
LEVPLAY_SVM_PRODUCT_MANIFESTS_JSON=[]

# Zoho Mail OAuth (India data centre). Keep credentials and tokens server-side.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
ZOHO_MAIL_API_BASE_URL=https://mail.zoho.in/api
ZOHO_MAIL_ADDRESS=info@levplay.tech
ZOHO_REDIRECT_URI=https://app.levplay.tech/api/integrations/zoho/callback

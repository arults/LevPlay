{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://levplay.tech/audit/deployment-manifest.schema.json",
  "title": "LevPlay AAPL 2x pilot deployment manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseCommit",
    "releaseArtifacts",
    "evidence",
    "programId",
    "configState",
    "programDataAddress",
    "programLoader",
    "upgradePolicy",
    "upgradeAuthority",
    "upgradeTimelockSeconds",
    "feeRecipient",
    "treasuryAuthority",
    "governance",
    "guardian",
    "multisigProgram",
    "markets"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "releaseCommit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "releaseArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSha256", "sbfSha256", "idlSha256", "sbomSha256", "toolchainImageDigest"],
      "properties": {
        "sourceSha256": { "$ref": "#/$defs/hash" },
        "sbfSha256": { "$ref": "#/$defs/hash" },
        "idlSha256": { "$ref": "#/$defs/hash" },
        "sbomSha256": { "$ref": "#/$defs/hash" },
        "toolchainImageDigest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independentAuditSha256", "economicAuditSha256", "auditorRetestSha256",
        "backingAttestationSha256", "reserveAttestationSha256", "venueManifestSha256",
        "productManifestsSha256", "governanceAccountSha256", "guardianAccountSha256",
        "legalApprovalSha256", "goLiveVoteSha256"
      ],
      "properties": {
        "independentAuditSha256": { "$ref": "#/$defs/hash" },
        "economicAuditSha256": { "$ref": "#/$defs/hash" },
        "auditorRetestSha256": { "$ref": "#/$defs/hash" },
        "backingAttestationSha256": { "$ref": "#/$defs/hash" },
        "reserveAttestationSha256": { "$ref": "#/$defs/hash" },
        "venueManifestSha256": { "$ref": "#/$defs/hash" },
        "productManifestsSha256": { "$ref": "#/$defs/hash" },
        "governanceAccountSha256": { "$ref": "#/$defs/hash" },
        "guardianAccountSha256": { "$ref": "#/$defs/hash" },
        "legalApprovalSha256": { "$ref": "#/$defs/hash" },
        "goLiveVoteSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "programId": { "$ref": "#/$defs/address" },
    "configState": { "$ref": "#/$defs/address" },
    "programDataAddress": { "$ref": "#/$defs/address" },
    "programLoader": { "$ref": "#/$defs/address" },
    "upgradePolicy": { "const": "frozen" },
    "upgradeAuthority": {
      "oneOf": [
        { "$ref": "#/$defs/address" },
        { "type": "null" }
      ]
    },
    "upgradeTimelockSeconds": { "type": "integer", "minimum": 0 },
    "feeRecipient": { "$ref": "#/$defs/address" },
    "treasuryAuthority": { "$ref": "#/$defs/address" },
    "governance": { "$ref": "#/$defs/address" },
    "guardian": { "$ref": "#/$defs/address" },
    "multisigProgram": { "$ref": "#/$defs/address" },
    "markets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AAPL2L", "AAPL2S"],
      "properties": {
        "AAPL2L": { "$ref": "#/$defs/longMarket" },
        "AAPL2S": { "$ref": "#/$defs/shortMarket" }
      }
    }
  },
  "allOf": [
    { "properties": { "upgradeAuthority": { "type": "null" }, "upgradeTimelockSeconds": { "const": 0 } } }
  ],
  "$defs": {
    "address": { "type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$" },
    "hash": { "type": "string", "pattern": "^(0x)?[a-fA-F0-9]{64}$" },
    "baseMarket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marketState",
        "clearingVault",
        "sourceVault",
        "reserveVault",
        "standbyBps",
        "productMint",
        "sourceProvider",
        "sourceAssetSymbol",
        "sourceMint",
        "sourceMintAccountSha256",
        "sourceRegistryHash",
        "primaryOracleAccount",
        "primaryOracleOwner",
        "primaryOracleFeedId",
        "primaryOracleProviderId",
        "secondaryOracleAccount",
        "secondaryOracleOwner",
        "secondaryOracleFeedId",
        "secondaryOracleProviderId",
        "adapterProgram",
        "adapterMarket",
        "adapterBinaryHash",
        "leverage",
        "side",
        "transactionCap",
        "walletCap",
        "tvlCap",
        "dailyMintCap",
        "dailyRedeemCap"
      ],
      "properties": {
        "marketState": { "$ref": "#/$defs/address" },
        "clearingVault": { "$ref": "#/$defs/address" },
        "sourceVault": { "$ref": "#/$defs/address" },
        "reserveVault": { "$ref": "#/$defs/address" },
        "standbyBps": { "type": "integer", "minimum": 1, "maximum": 500 },
        "productMint": { "$ref": "#/$defs/address" },
        "sourceProvider": { "const": "ondo" },
        "sourceAssetSymbol": { "const": "AAPLon" },
        "sourceMint": { "$ref": "#/$defs/address" },
        "sourceMintAccountSha256": { "$ref": "#/$defs/hash" },
        "sourceRegistryHash": { "$ref": "#/$defs/hash" },
        "primaryOracleAccount": { "$ref": "#/$defs/address" },
        "primaryOracleOwner": { "$ref": "#/$defs/address" },
        "primaryOracleFeedId": { "$ref": "#/$defs/hash" },
        "primaryOracleProviderId": { "type": "string", "minLength": 1 },
        "secondaryOracleAccount": { "$ref": "#/$defs/address" },
        "secondaryOracleOwner": { "$ref": "#/$defs/address" },
        "secondaryOracleFeedId": { "$ref": "#/$defs/hash" },
        "secondaryOracleProviderId": { "type": "string", "minLength": 1 },
        "adapterProgram": { "$ref": "#/$defs/address" },
        "adapterMarket": { "$ref": "#/$defs/address" },
        "adapterBinaryHash": { "$ref": "#/$defs/hash" },
        "leverage": { "const": 2 },
        "side": { "enum": ["long", "short"] }
        ,"transactionCap": { "type": "integer", "minimum": 1 }
        ,"walletCap": { "type": "integer", "minimum": 1 }
        ,"tvlCap": { "type": "integer", "minimum": 1 }
        ,"dailyMintCap": { "type": "integer", "minimum": 1 }
        ,"dailyRedeemCap": { "type": "integer", "minimum": 1 }
      }
    },
    "longMarket": {
      "allOf": [
        { "$ref": "#/$defs/baseMarket" },
        { "properties": { "side": { "const": "long" } } }
      ]
    },
    "shortMarket": {
      "allOf": [
        { "$ref": "#/$defs/baseMarket" },
        { "properties": { "side": { "const": "short" } } }
      ]
    }
  }
}
